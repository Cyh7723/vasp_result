# INCAR — 结构弛豫 (relax), 与 MP GGA 口径对齐
# 泛函: PBE, 无 +U (Li/Zr/Y/In/Cl 在 MP GGA_GGA+U 体系中均不加 U)
PREC    = Accurate
ENCUT   = 520        # Zr/Y 的 PAW 默认 ENMAX ~ 230-250, Cl ~ 400; 1.3*max ≈ 520
EDIFF   = 1E-6
EDIFFG  = -0.01      # 力收敛 10 meV/Å, 够反应能(≈meV/atom 级)用
ISMEAR  = 0          # 高斯展宽, 半导体/绝缘体标准
SIGMA   = 0.05
IBRION  = 2          # 共轭梯度
ISIF    = 3          # 全弛豫(原子位置+晶胞形状+体积)
NSW     = 150
POTIM   = 0.5
ALGO    = Normal
LREAL   = Auto
LWAVE   = .FALSE.
LCHARG  = .TRUE.     # 留 CHGCAR 给 static 续算(可选)
ADDGRID = .TRUE.     # 提高力的精度, MP 默认
LASPH   = .TRUE.     # 非球形校正, MP 默认
